{
  "name": "atlas-biblique-interactif",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/domain/history/temporal.test.ts src/domain/history/contentWorkflow.test.ts src/domain/history/stagingPromotion.test.ts src/domain/history/historicalSnapshot.test.ts src/adapters/legacyPeopleAdapter.test.ts",
    "build": "vite build",
    "check": "tsc --noEmit && pnpm run test && pnpm run historical:validate && pnpm run historical:promote -- --verify-output && node scripts/check-historical-compatibility.mjs && node scripts/check-map-source-priority.mjs && node scripts/check-jw-links.mjs && vite build && node scripts/check-pwa.mjs",
    "historical:validate": "node --experimental-strip-types scripts/validate-historical-data.mjs",
    "historical:promote": "node --experimental-strip-types scripts/promote-historical-staging.mjs",
    "historical:generate": "node --experimental-strip-types scripts/generate-historical-data.mjs",
    "historical:report:a7b": "node --experimental-strip-types scripts/report-historical-import.mjs --source source-nwtsty-a7-b",
    "historical:check": "node scripts/check-historical-compatibility.mjs",
    "map:sources:check": "node scripts/check-map-source-priority.mjs",
    "references:insight": "node scripts/generate-insight-references.mjs",
    "references:check": "node scripts/check-insight-references.mjs",
    "references:check:online": "node scripts/check-insight-references.mjs --online",
    "references:jw": "node scripts/check-jw-links.mjs",
    "pwa:assets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
    "pwa:check": "node scripts/check-pwa.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
